# Porta do servidor Fastify
PORT=3001
HOST=0.0.0.0

# Diretório de cache dos MP3 (default: ./cache)
# CACHE_DIR=./cache

# Origem permitida pelo CORS (default: * — ideal para uso local)
# CORS_ORIGIN=http://localhost:5173

# Limites de busca/mix
SEARCH_LIMIT=20
MIX_LIMIT=25

# Caminho do binário yt-dlp (default: resolve via PATH)
# YT_DLP_PATH=yt-dlp
# Cookies do YouTube (formato Netscape). Necessário em IP de datacenter, onde
# o YouTube exige "Sign in to confirm you're not a bot".
# YT_DLP_COOKIES=/home/ubuntu/ytdlp-cookies.txt

# Redis (cache inteligente de metadados + LRU)
REDIS_URL=redis://127.0.0.1:6379
# TTL do cache: faixas não ouvidas por mais que isso são removidas pelo job (7 dias)
CACHE_TTL_MS=604800000
# Intervalo entre execuções do job de limpeza (1 hora)
CLEANUP_INTERVAL_MS=3600000
